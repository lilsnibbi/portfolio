{
	"name": "portfolio",
	"private": true,
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@playwright/test": "1.65.1",
		"@tailwindcss/cli": "4.3.5",
		"@types/bun": "1.4.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"shadcn": "4.23.0",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@marsidev/react-turnstile": "1.6.3",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"entities": "9.0.0",
		"isbot": "5.2.3",
		"lucide-react": "^1.73.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router": "8.5.1"
	},
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "bun scripts/build.ts",
		"typecheck": "bunx tsc --noEmit",
		"check": "bun run typecheck && bunx biome check .",
		"test": "bun run build && bun test src",
		"test:e2e": "bunx playwright test",
		"test:e2e:ui": "bunx playwright test --ui",
		"test:e2e:report": "bunx playwright show-report",
		"start": "NODE_ENV=production bun build/server/index.js",
		"pretty": "bun x biome format --write ."
	}
}
